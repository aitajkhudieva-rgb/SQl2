--2
DECLARE @i INT = 1;
WHILE (SELECT COUNT(*) FROM Students) < 100000
BEGIN
    INSERT INTO Students (StudentID, FirstName, LastName, BirthDate, GPA)
    SELECT 
        (SELECT COUNT(*) FROM Students) + ROW_NUMBER() OVER (ORDER BY (SELECT NULL)),
        N'სახელი_' + CAST(@i AS NVARCHAR(10)),
        N'გვარი_' + CAST(@i AS NVARCHAR(10)),
        DATEADD(DAY, -(@i % 3650), GETDATE()),
        ROUND(2.0 + (@i % 20) * 0.1, 2)
    FROM master.dbo.spt_values
    WHERE type = 'P';
    
    SET @i += 1;
END;
